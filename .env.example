FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443
TLS_CERTIFICATE_PATH=/absolute/path/to/fullchain.pem
TLS_PRIVATE_KEY_PATH=/absolute/path/to/privkey.pem

MONGO_INITDB_ROOT_USERNAME=nottex_root
MONGO_INITDB_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

SECRET_KEY=
TOTP_ENCRYPTION_KEY=
FRONTEND_URL=https://your-domain.example
CORS_ALLOW_ORIGINS=["https://your-domain.example"]

EMAILS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
SMTP_FROM_EMAIL=noreply@nottex.com
SMTP_FROM_NAME=Nottex
