APP_NAME=Nottex
APP_VERSION=0.0.1
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

HOST=0.0.0.0
PORT=8000

CORS_ALLOW_ORIGINS=["http://localhost:5173", "http://localhost:3000", "*"]
CORS_ALLOW_CREDENTIALS=true

DATABASE_URL=mongodb://admin:password123@localhost:27017/?authSource=admin
DATABASE_USERS_NAME=nottex_users
DATABASE_NOTES_NAME=nottex_notes
DATABASE_MAX_POOL_SIZE=100
DATABASE_MIN_POOL_SIZE=10
DATABASE_MAX_IDLE_TIME_MS=30000
DATABASE_WAIT_QUEUE_TIMEOUT_MS=5000

EMAILS_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=false
SMTP_FROM_EMAIL=noreply@nottex.com
SMTP_FROM_NAME=Nottex
